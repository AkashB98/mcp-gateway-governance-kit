          "resource": "documents",
          "scopes": [
            "docs:read"
          ]
        },
        {
          "action": "create",
          "name": "create_doc",
          "resource": "documents",
          "scopes": [
            "docs:write"
          ]
        },
        {
          "action": "approve",
          "name": "approve_doc",
          "resource": "documents",
          "scopes": [
            "docs:approve"
          ]
        }
      ]
    },
    {
      "id": "warehouse",
      "name": "Helios Warehouse",
      "tools": [
        {
          "action": "read",
          "name": "query_data",
          "resource": "datasets",
          "scopes": [
            "warehouse:read"
          ]
        },
        {
          "action": "export",
          "name": "export_data",
          "resource": "datasets",
          "scopes": [
            "warehouse:read",
            "warehouse:export"
          ]
        },
        {
          "action": "write",
          "name": "manage_tables",
          "resource": "datasets",
          "scopes": [
            "warehouse:write"
          ]
        }
