{
  "name": "helios-home mcp catalog (fictional)",
  "servers": [
    {
      "id": "crm",
      "name": "Helios CRM",
      "tools": [
        {
          "action": "read",
          "name": "search_contacts",
          "resource": "contacts",
          "scopes": [
            "crm:contacts:read"
          ]
        },
        {
          "action": "create",
          "name": "create_contact",
          "resource": "contacts",
          "scopes": [
            "crm:contacts:write"
          ]
        },
        {
          "action": "export",
          "name": "export_contacts",
          "resource": "contacts",
          "scopes": [
            "crm:contacts:read",
            "crm:export"
          ]
        }
      ]
    },
    {
      "id": "billing",
      "name": "Helios Billing",
      "tools": [
        {
          "action": "read",
          "name": "view_invoice",
          "resource": "invoices",
          "scopes": [
            "billing:invoices:read"
          ]
        },
        {
          "action": "create",
          "name": "create_invoice",
          "resource": "invoices",
          "scopes": [
            "billing:invoices:write"
          ]
        },
        {
          "action": "approve",
          "name": "approve_invoice",
          "resource": "invoices",
          "scopes": [
            "billing:invoices:approve"
          ]
        },
        {
          "action": "read",
          "name": "view_payment",
          "resource": "payments",
          "scopes": [
            "billing:payments:read"
          ]
        },
        {
          "action": "write",
